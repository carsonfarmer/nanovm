{
  "uid": "nice-synthetic",
  "title": "Synthetic only — one request layer",
  "description": "Teaching fixture only, NOT nanovm or Collector measurements. nice_* metrics are invented. Supervisor and proxy each count the same synthetic requests; select exactly one layer. No tenant or object labels.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {"from": "now-5m", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Supervisor requests / s (synthetic)", "datasource": {"type": "prometheus", "uid": "nice-prom"}, "gridPos": {"x": 0, "y": 0, "w": 8, "h": 5}, "targets": [{"refId": "A", "expr": "sum(rate(nice_requests_total{layer=\"supervisor\"}[30s]))", "instant": true}], "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 0}}, "options": {"colorMode": "none", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 2, "type": "stat", "title": "Application errors (synthetic)", "datasource": {"type": "prometheus", "uid": "nice-prom"}, "gridPos": {"x": 8, "y": 0, "w": 8, "h": 5}, "targets": [{"refId": "A", "expr": "sum(rate(nice_requests_total{layer=\"supervisor\",outcome=\"error\"}[30s])) / sum(rate(nice_requests_total{layer=\"supervisor\"}[30s]))", "instant": true}], "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 0}}, "options": {"colorMode": "none", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 3, "type": "stat", "title": "Collector queue occupancy (synthetic)", "datasource": {"type": "prometheus", "uid": "nice-prom"}, "gridPos": {"x": 16, "y": 0, "w": 8, "h": 5}, "targets": [{"refId": "A", "expr": "nice_collector_queue_items / nice_collector_queue_capacity", "instant": true}], "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 0}}, "options": {"colorMode": "none", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},
    {"id": 4, "type": "timeseries", "title": "Supervisor outcomes / s — proxy layer excluded", "datasource": {"type": "prometheus", "uid": "nice-prom"}, "gridPos": {"x": 0, "y": 5, "w": 16, "h": 8}, "targets": [{"refId": "A", "expr": "sum by (outcome) (rate(nice_requests_total{layer=\"supervisor\"}[30s]))", "legendFormat": "{{outcome}}"}], "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 0}}}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 5, "type": "stat", "title": "Dropped spans / s (synthetic)", "datasource": {"type": "prometheus", "uid": "nice-prom"}, "gridPos": {"x": 16, "y": 5, "w": 8, "h": 8}, "targets": [{"refId": "A", "expr": "rate(nice_collector_dropped_spans_total[30s])", "instant": true}], "fieldConfig": {"defaults": {"unit": "ops", "decimals": 0}}, "options": {"colorMode": "none", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}}
  ]
}
